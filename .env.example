# Copiá este archivo a .env.local y completalo con los valores de tu proyecto.
# La publishable key está pensada para aplicaciones cliente y nunca reemplaza RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privada y solo de servidor: necesaria para escribir la imagen recodificada
# en la ruta final del bucket después de validar al usuario y su reserva.
# Nunca uses el prefijo NEXT_PUBLIC_ ni la copies al navegador.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
